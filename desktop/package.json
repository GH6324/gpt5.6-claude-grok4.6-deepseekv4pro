{
  "name": "coldbrew-atelier",
  "productName": "冷咖啡",
  "version": "5.0.0",
  "private": true,
  "description": "冷咖啡 · ColdBrew Command Center · 破甲与越狱的本地优先多模型工作台。",
  "main": "src/main.js",
  "author": "3641397194-wq",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "start": "electron .",
    "atelier": "electron .",
    "pack:win": "electron-builder --win portable --publish never",
    "pack:mac": "electron-builder --mac dmg zip --publish never",
    "pack:linux": "electron-builder --linux AppImage deb --publish never"
  },
  "devDependencies": {
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "app.coldbrew.jailbreak",
    "productName": "冷咖啡 Command Center",
    "copyright": "Copyright 2026 3641397194-wq",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../projects",
        "to": "core/projects",
        "filter": ["**/*"]
      }
    ],
    "asar": true,
    "icon": "assets/icon.png",
    "win": {
      "icon": "assets/icon.ico",
      "target": ["portable"]
    },
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools",
      "target": ["dmg", "zip"],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Development",
      "maintainer": "3641397194-wq",
      "desktop": {
        "Name": "冷咖啡 Command Center",
        "Comment": "破甲与越狱工作台",
        "Terminal": false,
        "Type": "Application",
        "Categories": "Development;"
      },
      "target": ["AppImage", "deb"]
    }
  }
}
